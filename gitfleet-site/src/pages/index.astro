---
import HeroSection from "../components/HeroSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TerminalPanel from "../components/TerminalPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "Gitfleet is a provider-neutral CLI for managing repositories across GitHub and GitLab.";
---

<BaseLayout title="Gitfleet" description={description}>
  <div class="site-shell min-h-dvh overflow-x-hidden bg-canvas text-ink">
    <div class="site-atmosphere" aria-hidden="true">
      <div class="site-atmosphere-glow"></div>
      <div class="site-atmosphere-grid"></div>
      <div class="site-atmosphere-radar"></div>
      <div class="site-atmosphere-noise"></div>
    </div>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="site-frame">
      <SiteHeader />

      <main id="main-content" class="site-stage" tabindex="-1">
        <HeroSection />
        <TerminalPanel />
      </main>

      <SiteFooter />
    </div>
  </div>

  <script>
    import "../scripts/homepage";
  </script>
</BaseLayout>
