---
import { Download, Star } from "@lucide/astro";

import { bannerLines, releaseUrl, repoUrl } from "../data/site";

const bannerSplitIndex = 21;
---

<section class="site-reveal flex max-w-3xl flex-col justify-center" aria-labelledby="site-heading">
  <h1 id="site-heading" class="sr-only">Gitfleet</h1>

  <p class="site-kicker">
    <span class="site-kicker-pulse" aria-hidden="true"></span>
    Provider-neutral CLI
  </p>

  <div class="ascii-frame">
    <pre
      class="ascii-title max-w-full overflow-hidden whitespace-pre font-mono font-semibold leading-none"
      aria-hidden="true">{bannerLines.map((line) => <span class="block"><span>{line.slice(0, bannerSplitIndex)}</span><span class="ascii-accent">{line.slice(bannerSplitIndex)}</span></span>)}</pre>
  </div>

  <p class="hero-copy">
    Command every repository as one fleet with a provider-neutral CLI for GitHub and GitLab. Use the
    same vocabulary for discovery, cloning, authentication, automation, and day-to-day repository
    work.
  </p>

  <div class="hero-actions">
    <a class="site-button site-button-primary" href={releaseUrl}>
      <Download class="h-4 w-4" aria-hidden="true" />
      Download Releases
    </a>
    <a class="site-button site-button-secondary" data-star-link href={repoUrl}>
      <Star class="h-4 w-4" aria-hidden="true" />
      Star On GitHub
      <span data-star-count></span>
    </a>
  </div>
</section>
