---
import { banner, bannerLines } from "@/data/site";
import { bannerGlyphPaths, bannerViewBox } from "@/scripts/banner";

const paths = bannerGlyphPaths(bannerLines);
const viewBox = bannerViewBox(bannerLines[0]?.length ?? 0, bannerLines.length);
---

<svg
  class="ascii-title"
  viewBox={viewBox}
  role="img"
  aria-label="Gitfleet"
  preserveAspectRatio="xMidYMid meet"
  shape-rendering="crispEdges"
  data-ascii-banner="vector"
>
  <title>Gitfleet</title>
  <desc>{banner}</desc>
  {
    paths.map((path) => (
      <path
        class:list={["ascii-glyph", path.accent && "ascii-accent"]}
        d={path.d}
        transform={`translate(${path.x} ${path.y})`}
      />
    ))
  }
</svg>
