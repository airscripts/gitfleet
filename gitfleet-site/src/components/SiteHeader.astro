---
import { BookOpen, Download, ExternalLink } from "@lucide/astro";

import { docsTreeUrl, releaseUrl, repoUrl } from "../data/site";
import SiteMark from "./SiteMark.astro";
---

<header class="site-header">
  <a href="/" class="site-brand" aria-label="Gitfleet home">
    <SiteMark />
    <div class="site-brand-copy">
      <p class="site-brand-name">Gitfleet</p>
      <p class="site-brand-tagline">Command Every Repository As One Fleet</p>
    </div>
  </a>

  <nav class="site-nav" aria-label="Primary links">
    <a class="site-nav-link" href={docsTreeUrl}>
      <BookOpen class="h-4 w-4" aria-hidden="true" />
      Docs
    </a>
    <a class="site-nav-link" href={repoUrl}>
      <ExternalLink class="h-4 w-4" aria-hidden="true" />
      GitHub
    </a>
    <a class="site-button site-button-primary site-nav-cta" href={releaseUrl}>
      <Download class="h-4 w-4" aria-hidden="true" />
      Releases
    </a>
  </nav>
</header>
