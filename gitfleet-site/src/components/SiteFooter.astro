---
import { Monitor, Moon, Sun } from "@lucide/astro";

import { repoUrl } from "../data/site";
---

<footer class="site-footer site-reveal [animation-delay:160ms]">
  <p>
    MIT Licensed. Maintained by
    {" "}
    <a class="site-footer-link" href="https://github.com/airscripts">Airscripts</a>.
  </p>
  <div class="site-footer-links">
    <a class="site-footer-link" href={`${repoUrl}/blob/main/CONTRIBUTING.md`}>Contributing</a>
    <a class="site-footer-link" href={`${repoUrl}/blob/main/SECURITY.md`}>Security</a>
    <a class="site-footer-link" href="https://github.com/sponsors/airscripts">Sponsor</a>
    <button
      class="theme-toggle inline-flex items-center justify-center"
      type="button"
      data-theme-toggle
      aria-label="Color theme: system. Switch to light theme."
    >
      <Sun class="theme-icon-sun h-4 w-4" aria-hidden="true" />
      <Moon class="theme-icon-moon h-4 w-4" aria-hidden="true" />
      <Monitor class="theme-icon-system h-4 w-4" aria-hidden="true" />
    </button>
  </div>
</footer>
